generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  number    String   @db.Char(9)
  fechaNac  DateTime @db.Date
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, name, number])
}